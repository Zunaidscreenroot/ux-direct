{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ux-direct",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-18",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "ux-direct"
    }
  ],
  "r2_buckets": [
    {
      "binding": "UX_SHARED_ASSETS",
      "bucket_name": "ux-shared-memory"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    // FREELLMAPI_BASE_URL is a Worker secret: the self-hosted tunnel URL can change, and the Mac updates it with `wrangler secret put`.
    "FREELLMAPI_CHAT_MODEL": "auto:smart",
    "FREELLMAPI_VISION_MODEL": "auto:vision",
    // Figma fallback chains: put exact ids of your strongest enabled free models first (see GET /v1/models).
    "FREELLMAPI_FIGMA_MODELS": "auto:smart",
    "FREELLMAPI_FIGMA_VISION_MODELS": "auto:vision"
  }
}
