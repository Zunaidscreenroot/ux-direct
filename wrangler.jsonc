{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ux-direct",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-18",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "ux-direct"
    }
  ],
  "r2_buckets": [
    {
      "binding": "UX_SHARED_ASSETS",
      "bucket_name": "ux-shared-memory"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  // Workers AI (free daily allocation) generates images for the Figma "insert image" quick task.
  "ai": {
    "binding": "AI"
  },
  // FreeLLMAPI on the owner's Mac, reached over the named tunnel freellmapi-mac (no public URL).
  "vpc_services": [
    {
      "binding": "FREELLMAPI_VPC",
      "service_id": "01a1b3b6-e9f5-7cb1-9981-0b58ccfc6c06",
      "remote": true
    }
  ],
  "observability": {
    "enabled": true
  },
  "vars": {
    // Own free-model gateway inside this Worker (src/llm-gateway). "fallback": FreeLLMAPI first, gateway when it
    // fails; "primary": gateway first; "only": no FreeLLMAPI/Mac at all; "off": old behaviour.
    // Provider keys are Worker secrets: GEMINI_API_KEY, GROQ_API_KEY, CEREBRAS_API_KEY, OPENROUTER_API_KEY,
    // MISTRAL_API_KEY, NVIDIA_API_KEY, ZAI_API_KEY, GITHUB_MODELS_TOKEN (comma-separate several keys to rotate).
    // "only" since 2026-11-07 (Zunaid): every model call goes through the own gateway; FreeLLMAPI code stays,
    // switch back with "fallback" (FreeLLMAPI first) or "primary" (gateway first) if ever needed.
    "UXD_LLM_GATEWAY": "only",
    // "vpc": FreeLLMAPI calls go through the FREELLMAPI_VPC binding. Set to "url" to fall back to the
    // FREELLMAPI_TUNNEL_URL secret (quick tunnel synced by scripts/freellmapi-tunnel-sync.sh).
    "FREELLMAPI_TRANSPORT": "vpc",
    "FREELLMAPI_CHAT_MODEL": "auto",
    "FREELLMAPI_VISION_MODEL": "auto",
    // Figma fallback chains: put exact ids of your strongest enabled free models first (see GET /v1/models).
    "FREELLMAPI_FIGMA_MODELS": "auto",
    "FREELLMAPI_FIGMA_VISION_MODELS": "auto"
  }
}
