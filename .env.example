# UX Direct Model Gateway — all keys optional; blank keys keep you in mock/local mode.
MODEL_PROVIDER=mock
# Default uses local/free-first routing. Change to an exact paid model ID only during final activation.
MODEL_GATEWAY_TASK_MODEL=uxd/reasoning
MODEL_GATEWAY_ACCESS_KEY=
# Required to save routing/budget settings from the dashboard in production.
MODEL_GATEWAY_ADMIN_KEY=
# Only for local development. Never enable this in production.
MODEL_GATEWAY_ALLOW_UNAUTHENTICATED_LOCAL=false

# Usage accounting. Leave the monthly budget blank unless you deliberately assign one.
MODEL_GATEWAY_MONTHLY_BUDGET_INR=
MODEL_GATEWAY_INPUT_PRICE_INR_PER_1M=0
MODEL_GATEWAY_OUTPUT_PRICE_INR_PER_1M=0

# Local inference (no model API key or per-token fee). Install Ollama and pull the models first.
OLLAMA_BASE_URL=
OLLAMA_MODELS=qwen2.5:7b,gemma4:31b

# Free-tier API providers (account keys required; quotas and model IDs vary).
GEMINI_API_KEY=
# Match this to the account/project billing tier; paid requires the global paid-routing opt-in below.
GEMINI_BILLING_MODE=free-tier
GEMINI_MODELS=gemini-3.5-flash-lite,gemini-2.5-flash-lite
GROQ_API_KEY=
GROQ_BILLING_MODE=free-tier
GROQ_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b
CEREBRAS_API_KEY=
CEREBRAS_BILLING_MODE=free-tier
CEREBRAS_MODELS=gpt-oss-120b
OPENROUTER_API_KEY=
# Use explicit :free model IDs. Do not use auto-routing for cost-sensitive workloads.
# Choose explicit current free model IDs. This list is editable in the final key/setup step.
OPENROUTER_MODELS=google/gemma-4-31b-it:free
# Internal IA/UX analysis: route dynamically via OpenRouter's low-cost Auto Router.
OPENROUTER_AUTO_ROUTING=true

# Optional direct provider routes. Disabled by default; OpenRouter Auto routing above has its own low-cost controls.
OPENAI_API_KEY=
OPENAI_MODELS=gpt-4o-mini
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODELS=deepseek-flash,deepseek-v4-pro
ALLOW_PAID_MODELS=false

# Optional custom OpenAI-compatible endpoint (local or paid).
CUSTOM_OPENAI_COMPATIBLE_BASE_URL=
CUSTOM_OPENAI_COMPATIBLE_API_KEY=
CUSTOM_OPENAI_COMPATIBLE_MODELS=default
CUSTOM_OPENAI_COMPATIBLE_KIND=local

# Figma integration (never commit real credentials)
FIGMA_ACCESS_TOKEN=
FIGMA_ALLOWED_FILE_IDS=

# ChatGPT MCP connector uses OAuth 2.1 authorization code + PKCE.
# Store these as Cloudflare Worker secrets, not build-time variables.
UX_DIRECT_MCP_OAUTH_SECRET=
UX_DIRECT_MCP_CONNECTION_CODE=
# Optional fixed issuer URL; leave blank to use the Worker origin.
UX_DIRECT_MCP_ISSUER_URL=
# Optional legacy bearer key for trusted server-to-server callers only; ChatGPT should use OAuth.
UX_DIRECT_MCP_API_KEY=

# Server-to-server access to the shared product brain; never expose to client bundles.
UX_DIRECT_BRAIN_API_KEY=

# OpenRouter-only model for screenshot-based UX audits; must be included in OPENROUTER_MODELS.
UXD_AUDIT_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free

# Existing screenshot/performance provider. Keep the token server-only.
BROWSERLESS_API_TOKEN=
BROWSERLESS_BASE_URL=https://production-sfo.browserless.io

# Internal UX Audit service endpoint used by the single UX Direct MCP connection.
# Defaults to the public uxaudit Worker URL if omitted.
UX_AUDIT_BASE_URL=https://uxaudit.zunaid-cb7.workers.dev

# Observability
LOG_LEVEL=info
