# UX Direct Model Gateway — all keys optional; without OpenRouter, AI routing stays unavailable/mock-only.
# Approved cockpit model pool:
# Free first: nvidia/nemotron-3.5-lightning:free, nvidia/nemotron-3-ultra-550b-a55b:free
# Paid fallback by expertise: openai/gpt-6-luna, deepseek/deepseek-v4.1-flash, deepseek/deepseek-v4-flash-0731
OPENROUTER_API_KEY=

# Generic/legacy paid-provider routes stay locked. The approved OpenRouter fallback has
# a separate server-side model allowlist and still passes gateway request/monthly budget checks.
ALLOW_PAID_MODELS=false

# Required to save routing/budget settings from the dashboard in production.
MODEL_GATEWAY_ADMIN_KEY=
# Used by the separately authenticated Model Gateway API route.
MODEL_GATEWAY_ACCESS_KEY=
# Only for local development. Never enable this in production.
MODEL_GATEWAY_ALLOW_UNAUTHENTICATED_LOCAL=false

# Usage accounting. The global cap defaults to ₹3,000. The dashboard stores exact model prices and caps.
MODEL_GATEWAY_MONTHLY_BUDGET_INR=3000
MODEL_GATEWAY_INPUT_PRICE_INR_PER_1M=0
MODEL_GATEWAY_OUTPUT_PRICE_INR_PER_1M=0

# Figma integration (never commit real credentials)
FIGMA_ACCESS_TOKEN=
FIGMA_ALLOWED_FILE_IDS=

# Observability
LOG_LEVEL=info
